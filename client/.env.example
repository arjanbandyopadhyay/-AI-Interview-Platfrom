# Copy to client/.env and fill in.

# Public Firebase web API key (the other Firebase settings are in src/utils/firebase.js)
VITE_FIREBASE_APIKEY=your_firebase_web_api_key
# Razorpay *key id* (public). Never put the key secret in the client.
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
# Backend URL (defaults to the deployed server). For local development:
# VITE_API_URL=http://localhost:5000
