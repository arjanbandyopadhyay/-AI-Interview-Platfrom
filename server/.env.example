# Copy to server/.env and fill in. Never commit the real .env file.

PORT=5000
# MongoDB connection string (the code reads MONGODB)
MONGODB=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/ai-interview
# Long random string used to sign login cookies (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me
OPENROUTER_API_KEY=your_openrouter_api_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- optional ---
# Firebase project the login tokens must belong to (defaults to this app's project)
# FIREBASE_PROJECT_ID=interviewiq-f0eb6
# Browser origin allowed by CORS (defaults to the deployed client). For local development:
# CLIENT_URL=http://localhost:5173
# Number of reverse proxies in front of the server (Render = 1). Used to find the real client IP for rate limiting.
# TRUST_PROXY=1
# Requests slower than this many milliseconds are logged as "SLOW ..." (default 3000).
# SLOW_REQUEST_MS=3000
